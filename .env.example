# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
#
# Account id: StreamOne ION portal > Quick Access > Account Information.
TDSYNNEX_ACCOUNT_ID=

# Refresh token: ION portal > Settings > Users > select the user > Edit >
# OAuth credentials > Request New Credentials. Refresh tokens are SINGLE-USE:
# every exchange returns a new one and invalidates the old one (valid 32 days).
# Use a dedicated API user. Set the refresh token, or the token file, or a
# static access token (below), in that order of precedence.
TDSYNNEX_REFRESH_TOKEN=

# Optional but strongly recommended with a refresh token: a file holding the
# CURRENT refresh token. If it exists it is read at first use (and wins over
# TDSYNNEX_REFRESH_TOKEN); after every exchange the rotated token is written
# back atomically with mode 0600. Without it the rotated token lives in memory
# only and is lost on restart.
# TDSYNNEX_REFRESH_TOKEN_FILE=/run/secrets/tdsynnex_refresh_token

# Alternative: a ready-made access (bearer) token. It expires after 2 hours and
# is not renewed. Ignored when a refresh token or token file is set.
# TDSYNNEX_ACCESS_TOKEN=

# Write operations (create customer/order/cart, update customer, cancel order,
# checkout cart) are OFF by default: write tools are not listed and calls are
# refused. Only the exact value "false" enables them. Orders and cancellations
# additionally need the preview/confirm step.
READ_ONLY_MODE=true

# Local safety caps on orders (this connector's own limits, not TD SYNNEX's).
# TDSYNNEX_MAX_ORDER_LINES=25
# TDSYNNEX_MAX_LINE_QUANTITY=1000

# HMAC key (>= 32 bytes) for order confirm tokens. If unset, a random
# per-process key is used (a warning is logged): tokens then do not survive a
# restart or work across replicas.
# Generate a value with: openssl rand -hex 32
# TDSYNNEX_CONFIRM_SECRET=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When CONDUIT_S2S_SECRET is set and MCP_HTTP_HOST is
# unset, the server binds 0.0.0.0 (container deploys). Set 127.0.0.1 to bind
# loopback. The insecure-dev bypass ignores a non-loopback value and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (so a copied example
# cannot forge X-Gateway-S2S). Compose will not start when it is unset.
# Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A placeholder CONDUIT_S2S_SECRET still refuses to start.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# x-tdsynnex-account-id and x-tdsynnex-access-token headers; no env fallback).
# The container image and the compose service set gateway. Stdio ignores this
# and reads TDSYNNEX_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
